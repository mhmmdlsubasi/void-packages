# Template file for 'zotero'
pkgname=zotero
version=9.0.6
revision=1
archs="x86_64"
depends="alsa-lib gtk+3 nss hicolor-icon-theme"
short_desc="Free, easy-to-use tool to help you collect, organize, cite, and share research sources"
maintainer="Muhammed Ali Subaşı <mhmmdlsubasi@gmail.com>"
license="AGPL-3.0-or-later"
homepage="https://www.zotero.org/"
distfiles="https://www.zotero.org/download/client/dl?channel=release&platform=linux-x86_64&version=${version}>Zotero-${version}_linux-x86_64.tar.bz2"
checksum="0db6e8f94bd0d84e862e6ef5c3e217030e173c0cd3c6dfbc836252c650fea3dd"
wrksrc="Zotero_linux-x86_64"

nostrip=yes
nopie=yes
noshlibs=yes

do_install() {
	vmkdir usr/lib/zotero
	vcopy "*" usr/lib/zotero

	vsed -i ${DESTDIR}/usr/lib/zotero/zotero \
		-e 's/^"$CALLDIR\/zotero-bin"/exec "$CALLDIR\/zotero-bin"/'

	# 1. Hedef dizini oluştur ve sembolik linki at
	vmkdir usr/bin
	ln -s /usr/lib/zotero/zotero ${DESTDIR}/usr/bin/zotero

	# 2. İkon kurulumları
	vinstall icons/icon32.png 644 usr/share/icons/hicolor/32x32/apps zotero.png
	vinstall icons/icon64.png 644 usr/share/icons/hicolor/64x64/apps zotero.png
	vinstall icons/icon128.png 644 usr/share/icons/hicolor/128x128/apps zotero.png
	vinstall icons/symbolic.svg 644 usr/share/icons/hicolor/symbolic/apps zotero-symbolic.svg

	# 3. Desktop dosyası
	vmkdir usr/share/applications
	cat <<EOF > ${DESTDIR}/usr/share/applications/zotero.desktop
[Desktop Entry]
Version=1.0
Type=Application
Name=Zotero
GenericName=Reference Manager
Comment=Collect, organize, cite, and share your research sources
Exec=zotero -url %U
Icon=zotero
Terminal=false
Categories=Office;Education;Science;
MimeType=text/plain;x-scheme-handler/zotero;application/x-research-info-systems;text/x-research-info-systems;text/ris;application/x-endnote-refer;application/x-inst-for-Scientific-info;application/mods+xml;application/rdf+xml;application/x-bibtex;text/x-bibtex;application/marc;application/vnd.citationstyles.style+xml;
X-GNOME-SingleWindow=true
EOF
}
