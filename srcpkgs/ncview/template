# Template file for 'ncview'
pkgname=ncview
version=2.1.11
revision=1
build_style=gnu-configure
hostmakedepends="pkg-config"
makedepends="netcdf-devel libXaw-devel libpng-devel udunits2-devel expat-devel"
short_desc="Visual browser for netCDF format files"
